{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAnime Theme",
  "version": "0.1.0",
  "identifier": "com.openanime.theme",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenAnime Theme",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2NjIzRDdDREExMTRENTIKUldSU1RSSGFmRDFpcGtSM3Z4a3g4Tno0SUtwYnpneHNIZEc4V282M0p6YW1abkxwekJOQSt0dDEK",
      "endpoints": [
        "https://github.com/Dark-Hunter-TR/OpenAnime-Thema/releases/latest/download/latest.json"
      ]
    }
  }
}
