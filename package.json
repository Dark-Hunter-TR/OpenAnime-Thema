{
  "name": "openanime-theme",
  "version": "0.1.0",
  "description": "openani.me için canlı önizlemeli görsel tema editörü",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test src",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "catalog": "node scripts/build-catalog.mjs",
    "tauri": "tauri",
    "set-version": "node scripts/set-version.mjs",
    "build:test": "tauri build --config src-tauri/tauri.test.conf.json --verbose",
    "build:release": "tauri build --verbose"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fluentui/svg-icons": "^1.1.334",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "fluent-svelte-extra": "2.2.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "sass": "^1.77.0",
    "svelte": "4.2.20",
    "svelte-check": "^3.8.6",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
